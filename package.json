{
  "name": "deepseek-json-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first viewer for DeepSeek chat exports.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
